          {/* =================================================================== */}
          {/* MODAL: FULLSCREEN STORY VIEWER */}
          {/* =================================================================== */}
          {viewingStory && (
            <div className="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
              <div
                style={{ background: viewingStory.bg }}
                className="w-full max-w-sm h-[520px] rounded-3xl p-6 text-white shadow-2xl flex flex-col justify-between relative"
              >
                {/* Progress bar */}
                <div className="w-full h-1 bg-white/30 rounded-full overflow-hidden">
                  <div className="w-full h-full bg-white animate-pulse" />
                </div>

                <div className="flex items-center justify-between mt-3">
                  <div className="flex items-center gap-2.5">
                    <img src={viewingStory.user.avatar} className="w-9 h-9 rounded-full border-2 border-white object-cover" />
                    <div>
                      <h4 className="font-bold text-xs">{viewingStory.user.name}</h4>
                      <p className="text-[10px] opacity-80">@{viewingStory.user.handle}</p>
                    </div>
                  </div>
                  <button onClick={() => setViewingStory(null)} className="text-xl p-1">✕</button>
                </div>

                <div className="space-y-3">
                  <h3 className="text-xl font-extrabold">{viewingStory.title}</h3>
                  <p className="text-sm leading-relaxed opacity-95">{viewingStory.caption}</p>
                </div>

                <div className="flex items-center justify-between text-xs pt-4 border-t border-white/20">
                  <span>✨ 24h Vibe Moment</span>
                  <button onClick={() => alert('Vibe liked!')} className="px-3 py-1 bg-white/20 rounded-full font-bold">❤️ Like</button>
                </div>
              </div>
            </div>
          )}

          {/* =================================================================== */}
          {/* MODAL: CREATE POST MODAL */}
          {/* =================================================================== */}
          {isCreatePostOpen && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 w-full max-w-lg rounded-3xl p-6 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4">
                <div className="flex items-center justify-between">
                  <h3 className="font-bold text-sm text-slate-900 dark:text-white">Create New Post</h3>
                  <button onClick={() => setIsCreatePostOpen(false)} className="text-slate-400">✕</button>
                </div>
                <form onSubmit={handleCreatePostSubmit} className="space-y-3">
                  <textarea
                    rows={4}
                    value={newPostText}
                    onChange={(e) => setNewPostText(e.target.value)}
                    placeholder={t('createPost')}
                    className="w-full p-3.5 text-xs bg-slate-100 dark:bg-slate-800 rounded-2xl outline-none text-slate-900 dark:text-white resize-none"
                    autoFocus
                  />
                  <div>
                    <label className="block text-[11px] font-semibold text-slate-500 mb-1">Image URL (Optional):</label>
                    <input
                      type="url"
                      value={newPostImage}
                      onChange={(e) => setNewPostImage(e.target.value)}
                      placeholder="https://images.unsplash.com/..."
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                    />
                  </div>
                  <div className="flex justify-end gap-2 pt-2">
                    <button
                      type="button"
                      onClick={() => setIsCreatePostOpen(false)}
                      className="px-4 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      className="px-5 py-2 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-xs"
                    >
                      {t('publish')}
                    </button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* =================================================================== */}
          {/* MODAL: CREATE GROUP */}
          {/* =================================================================== */}
          {isCreateGroupOpen && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 w-full max-w-md rounded-3xl p-5 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4">
                <div className="flex items-center justify-between">
                  <h3 className="font-bold text-sm text-slate-900 dark:text-white">Create New Group</h3>
                  <button onClick={() => setIsCreateGroupOpen(false)} className="text-slate-400">✕</button>
                </div>
                <form onSubmit={handleCreateGroupSubmit} className="space-y-3">
                  <div>
                    <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Group Name</label>
                    <input
                      type="text"
                      value={newGroupName}
                      onChange={(e) => setNewGroupName(e.target.value)}
                      placeholder="e.g. Seattle Street Photographers"
                      required
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Description</label>
                    <textarea
                      rows={3}
                      value={newGroupDesc}
                      onChange={(e) => setNewGroupDesc(e.target.value)}
                      placeholder="What is this community group about?"
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white resize-none"
                    />
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div>
                      <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Category</label>
                      <input
                        type="text"
                        value={newGroupCategory}
                        onChange={(e) => setNewGroupCategory(e.target.value)}
                        className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                      />
                    </div>
                    <div>
                      <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Privacy</label>
                      <select
                        value={newGroupPrivacy}
                        onChange={(e) => setNewGroupPrivacy(e.target.value)}
                        className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                      >
                        <option value="public">Public</option>
                        <option value="private">Private</option>
                      </select>
                    </div>
                  </div>
                  <div className="flex justify-end gap-2 pt-2">
                    <button
                      type="button"
                      onClick={() => setIsCreateGroupOpen(false)}
                      className="px-4 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      className="px-5 py-2 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-xs"
                    >
                      Create Group
                    </button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* =================================================================== */}
          {/* MODAL: CREATE CREATOR PAGE */}
          {/* =================================================================== */}
          {isCreatePageOpen && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 w-full max-w-md rounded-3xl p-5 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4">
                <div className="flex items-center justify-between">
                  <h3 className="font-bold text-sm text-slate-900 dark:text-white">Create Creator Page</h3>
                  <button onClick={() => setIsCreatePageOpen(false)} className="text-slate-400">✕</button>
                </div>
                <form onSubmit={handleCreatePageSubmit} className="space-y-3">
                  <div>
                    <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Page Name</label>
                    <input
                      type="text"
                      value={newPageName}
                      onChange={(e) => setNewPageName(e.target.value)}
                      placeholder="e.g. Kinova Labs Studio"
                      required
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Category</label>
                    <input
                      type="text"
                      value={newPageCategory}
                      onChange={(e) => setNewPageCategory(e.target.value)}
                      placeholder="Design Studio, Non-Profit, Brand"
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white"
                    />
                  </div>
                  <div>
                    <label className="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">About Description</label>
                    <textarea
                      rows={3}
                      value={newPageDesc}
                      onChange={(e) => setNewPageDesc(e.target.value)}
                      placeholder="Summary of this organization or brand..."
                      className="w-full px-3 py-2 text-xs bg-slate-100 dark:bg-slate-800 rounded-xl outline-none text-slate-900 dark:text-white resize-none"
                    />
                  </div>
                  <div className="flex justify-end gap-2 pt-2">
                    <button
                      type="button"
                      onClick={() => setIsCreatePageOpen(false)}
                      className="px-4 py-2 text-xs font-semibold text-slate-500 hover:bg-slate-100 rounded-xl"
                    >
                      Cancel
                    </button>
                    <button
                      type="submit"
                      className="px-5 py-2 text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-xs"
                    >
                      Create Page
                    </button>
                  </div>
                </form>
              </div>
            </div>
          )}

          {/* =================================================================== */}
          {/* MODAL: LEGAL & PRIVACY CENTER */}
          {/* =================================================================== */}
          {isLegalModalOpen && (
            <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs flex items-center justify-center p-4">
              <div className="bg-white dark:bg-slate-900 w-full max-w-2xl max-h-[85vh] rounded-3xl p-6 border border-slate-200 dark:border-slate-800 shadow-2xl flex flex-col">
                <div className="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
                  <h3 className="font-bold text-base text-slate-900 dark:text-white flex items-center gap-2">
                    🛡️ Kinova Legal & Compliance Center
                  </h3>
                  <button onClick={() => setIsLegalModalOpen(false)} className="text-slate-400 hover:text-slate-600">✕</button>
                </div>

                <div className="flex gap-2 pt-3 border-b border-slate-100 dark:border-slate-800 overflow-x-auto pb-2">
                  {[
                    { id: 'privacy', label: 'Privacy Policy' },
                    { id: 'terms', label: 'Terms of Service' },
                    { id: 'cookies', label: 'Cookie Preferences' },
                    { id: 'guidelines', label: 'Community Guidelines' },
                  ].map(tab => (
                    <button
                      key={tab.id}
                      onClick={() => setLegalTab(tab.id)}
                      className={`px-3 py-1.5 text-xs font-bold rounded-xl whitespace-nowrap transition-colors ${
                        legalTab === tab.id
                          ? 'bg-indigo-600 text-white'
                          : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
                      }`}
                    >
                      {tab.label}
                    </button>
                  ))}
                </div>

                <div className="flex-1 overflow-y-auto py-4 space-y-4 text-xs leading-relaxed text-slate-700 dark:text-slate-300">
                  {legalTab === 'privacy' && (
                    <div className="space-y-3">
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">1. Data Ownership & Privacy Protection</h4>
                      <p>At Kinova Social Inc., your personal data, direct messages, and private group discussions remain encrypted and strictly protected. We never sell your personal data or user telemetry to third-party ad brokers.</p>
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">2. In-Memory Synthesizer & Canvas Safety</h4>
                      <p>All drawings generated during Co-Play Pictionary battles are processed locally on device canvas memory and synchronized in real-time without unauthorized third-party archiving.</p>
                    </div>
                  )}

                  {legalTab === 'terms' && (
                    <div className="space-y-3">
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">1. Acceptance of Terms</h4>
                      <p>By accessing or interacting with Kinova Social, you agree to abide by these terms, respecting intellectual property and respectful group collaboration.</p>
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">2. Community Standards</h4>
                      <p>Users must not upload abusive, defamatory, or unlawful content in groups, creator pages, or direct messages.</p>
                    </div>
                  )}

                  {legalTab === 'cookies' && (
                    <div className="space-y-3">
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">Cookie & Local Storage Preferences</h4>
                      <p>Kinova uses strictly necessary local storage cookies to remember your active persona, dark mode preference, and selected language setting.</p>
                      <div className="p-3 bg-slate-100 dark:bg-slate-800 rounded-xl space-y-2">
                        <label className="flex items-center gap-2">
                          <input type="checkbox" defaultChecked disabled className="rounded text-indigo-600" />
                          <span>Essential System Cookies (Required for Auth & Theme)</span>
                        </label>
                        <label className="flex items-center gap-2">
                          <input type="checkbox" defaultChecked className="rounded text-indigo-600" />
                          <span>Audio Synthesis Performance Cache</span>
                        </label>
                      </div>
                    </div>
                  )}

                  {legalTab === 'guidelines' && (
                    <div className="space-y-3">
                      <h4 className="font-bold text-sm text-slate-900 dark:text-white">Kinova Community Trust & Safety</h4>
                      <p>Be kind, constructive, and respectful when participating in open groups and synchronized lounges. Harassment and hate speech result in immediate account suspension.</p>
                    </div>
                  )}
                </div>

                <div className="pt-3 border-t border-slate-200 dark:border-slate-800 flex justify-end">
                  <button
                    onClick={() => setIsLegalModalOpen(false)}
                    className="px-5 py-2 bg-indigo-600 text-white text-xs font-bold rounded-xl"
                  >
                    Close
                  </button>
                </div>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<KinovaApp />);
  </script>
</body>
</html>
