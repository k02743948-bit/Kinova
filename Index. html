    // 1. WEB AUDIO SYNTHESIZER & SPEECH SYNTHESIS ENGINE
    // =========================================================================
    class WebAudioEngine {
      constructor() {
        this.ctx = null;
        this.isPlaying = false;
        this.nodes = [];
      }
      init() {
        if (!this.ctx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContextClass();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }
      playVibe(vibe = 'lofi') {
        this.stop();
        this.init();
        if (!this.ctx) return;
        this.isPlaying = true;

        const master = this.ctx.createGain();
        master.gain.setValueAtTime(0.01, this.ctx.currentTime);
        master.gain.exponentialRampToValueAtTime(0.14, this.ctx.currentTime + 1.0);
        master.connect(this.ctx.destination);
        this.nodes.push(master);

        const chordSets = {
          lofi: [[220, 261.63, 329.63, 392], [174.61, 220, 261.63, 329.63], [196, 246.94, 293.66, 349.23], [164.81, 196, 246.94, 329.63]],
          cyberpunk: [[130.81, 196, 233.08, 293.66], [146.83, 220, 261.63, 329.63], [116.54, 174.61, 207.65, 261.63]],
          sunset: [[261.63, 329.63, 392, 493.88], [220, 261.63, 329.63, 440], [174.61, 220, 261.63, 349.23]],
          zen: [[196, 293.66, 392, 587.33], [220, 329.63, 440, 659.25], [164.81, 246.94, 329.63, 493.88]]
        };

        const chords = chordSets[vibe] || chordSets.lofi;
        let idx = 0;

        const tick = () => {
          if (!this.isPlaying || !this.ctx) return;
          const chord = chords[idx % chords.length];
          idx++;
          const gain = this.ctx.createGain();
          gain.gain.setValueAtTime(0.001, this.ctx.currentTime);
          gain.gain.linearRampToValueAtTime(0.11, this.ctx.currentTime + 0.8);
          gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 3.8);
          gain.connect(master);

          chord.forEach(freq => {
            const osc = this.ctx.createOscillator();
            osc.type = vibe === 'cyberpunk' ? 'sawtooth' : 'sine';
            osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
            const filter = this.ctx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(vibe === 'cyberpunk' ? 1400 : 850, this.ctx.currentTime);
            osc.connect(filter);
            filter.connect(gain);
            osc.start(this.ctx.currentTime);
            osc.stop(this.ctx.currentTime + 4.0);
          });
        };
        tick();
        const intId = setInterval(tick, 3800);
        this.nodes.push(intId);
      }
      stop() {
        this.isPlaying = false;
        this.nodes.forEach(n => {
          if (typeof n === 'number') clearInterval(n);
          else { try { n.disconnect(); } catch(e){} }
        });
        this.nodes = [];
      }
      speak(text, onEnd) {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const ut = new SpeechSynthesisUtterance(text);
        ut.rate = 0.95;
        if (onEnd) {
          ut.onend = onEnd;
          ut.onerror = onEnd;
        }
        window.speechSynthesis.speak(ut);
      }
      stopSpeech() {
        if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      }
    }
